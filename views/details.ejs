<%- include("partials/head") %>
<%- include("partials/nav") %>
<main class="wrap narrow">
  <a class="back" href="/desk"><%= student ? "Back to waiting items" : "Back to the shelf" %></a>
  <% if (flash) { %><p class="banner" role="status"><%= flash %></p><% } %>
  <% if (!student && item.spot === "Pending Inspection") { %>
    <p class="banner banner-wait" role="status">A student reported this item. Students cannot see it yet. When it reaches the desk, click Edit and enter its real shelf spot to put it on the waiting list.</p>
  <% } %>
  <article class="detail status-<%= item.status %>">
    <div class="card-top">
      <span class="pill pill-<%= item.status %>"><%= item.statusLabel %></span>
      <span class="code"><%= item.code %></span>
    </div>
    <h1><%= item.name %></h1>
    <p class="meta"><%= item.categoryLabel %> · found at <%= item.placeLabel %></p>
    <% if (item.hasCover) { %><%- include("partials/cover", { item }) %><% } %>
    <dl class="facts">
      <div><dt>Campus</dt><dd><%= item.campusLabel %></dd></div>
      <div><dt>Found</dt><dd><%= item.foundLabel %></dd></div>
      <% if (!student) { %>
        <div><dt>Shelf spot</dt><dd><%= item.spot || "Not written down" %></dd></div>
      <% } %>
      <div><dt>Logged by</dt><dd><%= item.loggedBy || "Unknown" %></dd></div>
      <% if (!student && item.reportedBy !== "Staff") { %>
        <div><dt>Reported by</dt><dd><%= item.reportedBy %></dd></div>
        <div><dt>Reporter contact</dt><dd><%= item.reporterContact || "Not given" %></dd></div>
      <% } %>
      <div><dt>Status</dt><dd><%= item.statusLabel %></dd></div>
    </dl>
    <% if (item.description) { %><p class="note"><%= item.description %></p><% } %>
    <% if (!student) { %>
    <div class="form-actions">
      <a class="btn" href="/desk/<%= item.code %>/edit">Edit</a>
      <% if (item.status !== "claimed") { %>
        <form method="post" action="/desk/<%= item.code %>/status">
          <input type="hidden" name="status" value="claimed">
          <button class="btn btn-ghost" type="submit">Mark claimed</button>
        </form>
      <% } %>
      <% if (item.status !== "disposed") { %>
        <form method="post" action="/desk/<%= item.code %>/status">
          <input type="hidden" name="status" value="disposed">
          <button class="btn btn-ghost" type="submit">Clear from shelf</button>
        </form>
      <% } %>
      <% if (item.status !== "stored") { %>
        <form method="post" action="/desk/<%= item.code %>/status">
          <input type="hidden" name="status" value="stored">
          <button class="btn btn-ghost" type="submit">Put back in storage</button>
        </form>
      <% } %>
      <form method="post" action="/desk/<%= item.code %>/delete" onsubmit="return confirm('Remove this record from the desk?');">
        <button class="btn btn-danger" type="submit">Delete</button>
      </form>
    </div>
    <% } else { %>
      <p class="help">Come to <%= desk.place %> (<%= desk.placeZh %>). Staff will check who you are, then bring this item out. Call <%= desk.phone %> if you found something and need the desk to collect it.</p>
    <% } %>
  </article>
</main>
<%- include("partials/foot") %>
