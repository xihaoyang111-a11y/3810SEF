<% if (error) { %>
  <p class="banner banner-bad" role="alert"><%= error %></p>
<% } %>
<form class="sheet item-editor" method="post" enctype="multipart/form-data" action="<%= action %>">
  <div class="item-fields">
  <div class="field">
    <label for="name">Item name</label>
    <input id="name" name="name" required maxlength="80" value="<%= values.name %>">
  </div>

  <% if (mode !== "create") { %>
    <p class="code-lock">Reference <strong><%= values.code %></strong></p>
  <% } %>

  <div class="split">
    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category">
        <% CATEGORIES.forEach(function (c) { %>
          <option value="<%= c %>" <%= values.category === c ? "selected" : "" %>><%= categoryLabel(c) %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="campus">Campus</label>
      <select id="campus" name="campus">
        <% CAMPUSES.forEach(function (c) { %>
          <option value="<%= c %>" <%= values.campus === c ? "selected" : "" %>><%= campusLabel(c) %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="split">
    <div class="field">
      <label for="place">Found at</label>
      <select id="place" name="place">
        <% PLACES.forEach(function (p) { %>
          <option value="<%= p %>" <%= values.place === p ? "selected" : "" %>><%= placeLabel(p) %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <% STATUSES.forEach(function (s) { %>
          <option value="<%= s %>" <%= values.status === s ? "selected" : "" %>><%= statusLabel(s) %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="foundOn">Date found</label>
      <input id="foundOn" name="foundOn" type="date" required value="<%= values.foundOn %>">
    </div>
  </div>

  <div class="field">
    <label for="loggedBy">Logged by</label>
    <select id="loggedBy" name="loggedBy">
      <option value="Staff" <%= values.loggedBy === "Student" ? "" : "selected" %>>Staff</option>
      <option value="Student" <%= values.loggedBy === "Student" ? "selected" : "" %>>Student</option>
    </select>
  </div>
  <div class="field">
    <label for="spot">Shelf spot <span class="hint">optional</span></label>
    <input id="spot" name="spot" maxlength="80" value="<%= values.spot %>">
  </div>
  <div class="field">
    <label for="description">Description <span class="hint">optional</span></label>
    <textarea id="description" name="description" maxlength="280" rows="3"><%= values.description %></textarea>
  </div>

  </div>
  <aside class="photo-panel" aria-labelledby="photo-label">
    <h2 id="photo-label">Cover photo</h2>
    <img id="cover-preview" class="item-cover" alt="Cover photo preview"
      <% if (values.hasCover) { %>src="/desk/<%= values.code %>/cover"<% } else { %>hidden<% } %>>
    <div class="field">
      <label for="cover"><%= values.hasCover ? "Replace photo" : "Choose a photo" %></label>
      <input id="cover" type="file" name="cover" accept="image/jpeg,image/png,image/webp" aria-describedby="photo-help">
      <small id="photo-help">JPEG, PNG or WebP, up to 2 MB. Cover photos are visible to signed-in students while the item is available. Keep names and ID numbers out of the photo.</small>
    </div>
    <% if (values.hasCover) { %>
      <label class="photo-remove"><input type="checkbox" name="removeCover" value="1"> Remove existing photo</label>
    <% } %>
  </aside>
  <div class="form-actions">
    <button class="btn" type="submit"><%= mode === "create" ? "Save record" : "Update record" %></button>
    <a class="btn btn-ghost" href="<%= mode === "create" ? "/desk" : "/desk/" + values.code %>">Cancel</a>
  </div>
</form>

<script src="/js/cover-preview.js" defer></script>
