<header class="topbar">
  <a class="brand" href="/desk">
    <span class="mark" aria-hidden="true"></span>
    Lost Desk
  </a>

  <nav class="topnav" aria-label="Desk">
    <% if (user.role === "student") { %>
      <a href="/desk" <%= title === "Waiting" ? 'aria-current="page"' : "" %>>Browse items</a>
    <% } else { %>
      <a href="/desk" <%= title === "Desk" ? 'aria-current="page"' : "" %>>Items</a>
      <a href="/desk/analytics">Analytics</a>
    <% } %>

    <form class="logout" action="/logout" method="post">
      <a class="who profile-link" href="/profile" title="My Profile">
        <img src="/icons/user.svg" class="profile-icon" alt="">
        My profile
      </a>

      <button type="submit">Log out</button>
    </form>
  </nav>
</header>